# Copy this file to .env for local testing. NEVER commit the real .env.
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:replace_with_bot_token
# Pyrogram user session string (needed for voice-chat streaming). Keep it secret.
STRING_SESSION=
OWNER_ID=123456789
# Direct audio stream URL you have permission to rebroadcast.
STREAM_URL=https://example.com/radio.mp3
# For /channelpost: @channelusername or numeric ID like -1001234567890
CHANNEL_USERNAME=@yourchannel
CHANNEL_LINK=https://t.me/yourchannel
